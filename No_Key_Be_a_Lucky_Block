local function getZones()
    local list = {}
    local f = workspace:FindFirstChild("CollectZones")
    if f then
        for _,v in pairs(f:GetChildren()) do
            if v:IsA("BasePart") then
                table.insert(list, v.Name)
            end
        end
    end
    return list
end

local function getSelectedZone()
