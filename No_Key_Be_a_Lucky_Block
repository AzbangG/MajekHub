--// ================= AUTO SELL (SMART LOOP) =================
local sellThread

startSelling = function()
	if sellThread then return end

	sellThread = task.spawn(function()
		while autoSell do
        	if not autoSell then
            	task.wait(0.5)
            	continue
        	end

        	local tools = getTools()

        	for i = 1, #tools do
            	if not autoSell then break end

            	local tool = tools[i]
            	if not tool:IsA("Tool") then continue end

            	local attr = tool:GetAttributes()
            	local id = attr.EntityId
            	if not id then continue end

            	-- 🧠 Brainrot
            	if attr.BrainrotType then
                	if sellMode == "ALL" then
                    	SellBrainrot:InvokeServer(id)
						print("[Sell] Selling_All...")

                	elseif sellMode == "Mutation" then
                    	local mut = attr.BrainrotMutation or "NORMAL"
                    	if selectedMutations[mut] then
                        	SellBrainrot:InvokeServer(id)
							print("[Sell] Selling_Brainrot...")
                   		end
                	end
            	end

            	-- 🎁 LuckyBlock
            	if attr.LuckyBlockType then
                	SellLucky:InvokeServer(id)
					print("[Sell] Selling_Lucky_Block...")
            	end

        	end

        	-- ⏱ cooldown pintar (bisa stop kapan aja)
        	local t = 0
    		while t < tonumber(sell_cooldown) do
            	if not autoSell then break end
            	task.wait(1)
            	t += 1
        	end
    	end
	end)
end

stopSelling = function()
	autoSell = false
    if sellThread then
        task.cancel(sellThread)
        sellThread = nil
    end
end

AutoSell:OnChanged(function(v)
    autoSell = v
    if v then
        startSelling()
    else
        stopSelling()
    end
end)

--// ================= AUTO WAR MINIGAME =================

local warThread
local VIM = game:GetService("VirtualInputManager")

local function getWarBar()
    local hud = player.PlayerGui:FindFirstChild("HUD")
    return hud and hud:FindFirstChild("WarBar")
end

local function getWarMovingTarget()
    local wb = getWarBar()
    if not wb then return nil end
    local container = wb:FindFirstChild("TargetContainer")
    return container and container:FindFirstChild("MovingTarget")
end

local function getWarSideTarget()
    local wb = getWarBar()
    if not wb then return nil end
    local miniMap = wb:FindFirstChild("MiniMap2")
    if not miniMap then return nil end
    return miniMap:FindFirstChild(selectedWarMinigame) -- "Coral" / "Luke"
end

local function isWarAligned(moving, target)
    local mCenterX = moving.AbsolutePosition.X + (moving.AbsoluteSize.X / 2)
    local tLeft    = target.AbsolutePosition.X
    local tRight   = target.AbsolutePosition.X + target.AbsoluteSize.X
    return mCenterX >= tLeft and mCenterX <= tRight
end

local function triggerWarKey()
    VIM:SendKeyEvent(true,  Enum.KeyCode.ButtonX, false, game)
    task.wait(0.1)
    VIM:SendKeyEvent(false, Enum.KeyCode.ButtonX, false, game)
end

local function startWarMinigame()
    if warThread then return end

    warThread = task.spawn(function()
        local triggered = false

        while autoWarMinigame do
            local wb = getWarBar()

            if wb and wb.Visible then
                local movingTarget = getWarMovingTarget()
                local sideTarget   = getWarSideTarget()
                local triggerBtn = player.PlayerGui.HUD.WarBar.ConsoleBTN.BTN.Button

                if movingTarget and sideTarget then
                    if isWarAligned(movingTarget, sideTarget) then
                        if not triggered and getconnections then
                            triggered = true
                            pcall(function() for _, conn in pairs(getconnections(triggerBtn.MouseButton1Click)) do conn:Fire() end end)
                            pcall(function() for _, conn in pairs(getconnections(triggerBtn.Activated)) do conn:Fire() end end)
                            task.wait(0.4)
                        end
                    else
                        triggered = false
                    end
                end
            else
                triggered = false
            end

            task.wait(0.016)
        end

        warThread = nil
    end)
end

local function stopWarMinigame()
    autoWarMinigame = false
    if warThread then
        task.cancel(warThread)
        warThread = nil
    end
end

AutoWar:OnChanged(function(v)
    autoWarMinigame = v
    if v then
        startWarMinigame()
    else
        stopWarMinigame()
    end
end)

