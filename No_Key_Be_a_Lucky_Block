--// ================= AUTO REFRESH ZONE =================

local zoneCons = {}

local function clearZoneCons()
    for _,c in pairs(zoneCons) do
        c:Disconnect()
    end
    table.clear(zoneCons)
end

local function setupZoneRefresh()
    local function hook(folder)
        clearZoneCons()
        ZoneDropdown:SetValues(getZones())

        table.insert(zoneCons, folder.ChildAdded:Connect(function(c)
            if c:IsA("BasePart") then
                ZoneDropdown:SetValues(getZones())
            end
        end))

        table.insert(zoneCons, folder.ChildRemoved:Connect(function(c)
            if c:IsA("BasePart") then
                ZoneDropdown:SetValues(getZones())
            end
        end))
    end

    local f = workspace:FindFirstChild("CollectZones")
    if f then hook(f) end

    table.insert(zoneCons, workspace.ChildAdded:Connect(function(c)
        if c.Name == "CollectZones" then
            task.wait(0.2)
            hook(c)
        end
    end))
end

setupZoneRefresh()

