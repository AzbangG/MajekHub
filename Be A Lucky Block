--// ================= AUTO SELL (SMART LOOP) =================
local sellThread

startSelling = function()
	if sellThread then return end

	sellThread = task.spawn(function()
		while autoSell do
        	if not autoSell then
            	task.wait(0.5)
            	continue
        	end

        	local tools = getTools()

        	for i = 1, #tools do
            	if not autoSell then break end

            	local tool = tools[i]
            	if not tool:IsA("Tool") then continue end

            	local attr = tool:GetAttributes()
            	local id = attr.EntityId
            	if not id then continue end

            	-- 🧠 Brainrot
            	if attr.BrainrotType then
                	if sellMode == "ALL" then
                    	SellBrainrot:InvokeServer(id)
						print("[Sell] Selling_All...")

                	elseif sellMode == "Mutation" then
                    	local mut = attr.BrainrotMutation or "NORMAL"
                    	if selectedMutations[mut] then
                        	SellBrainrot:InvokeServer(id)
							print("[Sell] Selling_Brainrot...")
                   		end
                	end
            	end

            	-- 🎁 LuckyBlock
            	if attr.LuckyBlockType then
                	SellLucky:InvokeServer(id)
					print("[Sell] Selling_Lucky_Block...")
            	end

        	end

        	-- ⏱ cooldown pintar (bisa stop kapan aja)
        	local t = 0
    		while t < tonumber(sell_cooldown) do
            	if not autoSell then break end
            	task.wait(1)
            	t += 1
        	end
    	end
	end)
end

stopSelling = function()
	autoSell = false
    if sellThread then
        task.cancel(sellThread)
        sellThread = nil
    end
end

AutoSell:OnChanged(function(v)
    autoSell = v
    if v then
        startSelling()
    else
        stopSelling()
    end
end)

