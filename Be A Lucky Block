--// PATHFINDING WALK
local function walkToPositionDetect(targetPos, timeoutDuration, label)
    label = label or "Target"
    timeoutDuration = timeoutDuration or 10

    if isWalking then
        dprint("⚠️ Already walking, please wait...")
        return false
    end

    local char = player.Character
    if not char then
        dprint("❌ " .. label .. ": Character not found")
        return false
    end

    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then
        dprint("❌ " .. label .. ": Humanoid not found")
        return false
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        dprint("❌ " .. label .. ": HRP not found")
        return false
    end

    isWalking = true
    dprint("🚶 Walking to " .. label .. " using Pathfinding...")

    local path = PathfindingService:FindPathAsync(hrp.Position, targetPos)

    if not path then
        dprint("❌ Path not found, using direct MoveTo...")
        humanoid:MoveTo(targetPos)
        task.wait(2)
        isWalking = false
        return false
    end

    local waypoints = path:GetWaypoints()
    local blocked = false

    local blockedConn = path.Blocked:Connect(function()
        dprint("⚠️ Path blocked at waypoint, recalculating...")
        blocked = true
    end)

    local startTime = tick()

    for i, waypoint in ipairs(waypoints) do
        if not isWalking or tick() - startTime > timeoutDuration then break end

        humanoid:MoveTo(waypoint.Position)

        local reached = false
        for j = 1, 100 do
            if not isWalking then break end
            local dist = (hrp.Position - waypoint.Position).Magnitude
            if dist < 5 then
                reached = true
                break
            end
            if blocked then break end
            task.wait(0.1)
        end

        if blocked or not reached then break end
    end

    blockedConn:Disconnect()

    local finalDistance = (hrp.Position - targetPos).Magnitude

    if finalDistance < 5 then
        dprint("✅ Arrived at " .. label .. " (distance: " .. math.floor(finalDistance) .. " studs)")
        isWalking = false
        return true
    else
        dprint("⏱️ Timeout at " .. label .. " (distance: " .. math.floor(finalDistance) .. " studs)")
        isWalking = false
        return false
    end
end

--// WAVEBLOCKER
local function createWaveblocker(root)
    if not root or not root.Parent then
        dprint("❌ Wave root not found")
        return nil
    end

    local rootSize = root.Size

    local waveblocker = Instance.new("Part")
    waveblocker.Name = "Waveblocker"
    waveblocker.Size = Vector3.new(rootSize.X + 30, rootSize.Y + 50, rootSize.Z + 100)
    waveblocker.CanCollide = true
    waveblocker.Transparency = 1
    waveblocker.CFrame = root.CFrame
    waveblocker.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = waveblocker
    weld.Parent = waveblocker

    dprint("📦 Waveblocker created, size: " .. tostring(waveblocker.Size))
    return waveblocker
end

local function removePlatform(platform)
    if platform and platform.Parent then
        platform:Destroy()
    end
end

--// AUTO FARM
local wavePlatform = nil

local function startAutoFarm()
    if farmConnection then return end

    farmConnection = task.spawn(function()
        local waves = workspace:WaitForChild("Waves")

        while autoFarmBlock do
            if walkToPositionDetect(kickCF.Position, 5, "Kick Area") then
                dprint("✅ Ready to kick!")
            else
                dprint("⚠️ Couldn't reach kick area, proceeding anyway")
            end

            local kickBtn = playerGui:WaitForChild("HUD"):WaitForChild("KickButton")
            if kickBtn and getconnections then
                pcall(function() for _, conn in pairs(getconnections(kickBtn.Activated)) do conn:Fire() end end)
            end

            local newWave
            local conn
            conn = waves.ChildAdded:Connect(function(child)
                newWave = child
            end)
            repeat task.wait() until newWave or not autoFarmBlock
            if conn then conn:Disconnect() end
            if not autoFarmBlock then break end

            task.wait(0.05)

            local root
            if newWave:IsA("Model") then
                root = newWave:FindFirstChild("Root") or newWave.PrimaryPart
            elseif newWave:IsA("BasePart") then
                root = newWave
            end

            if root then
                if wavePlatform then
                    dprint("🗑️ Cleaning up old waveblocker before creating new one...")
                    removePlatform(wavePlatform)
                    wavePlatform = nil
                end

                wavePlatform = createWaveblocker(root)

                if walkToPositionDetect(KickArea.Position, 18, "Safe Area (KickArea)") then
                    dprint("✅ Standing in safe area!")
                else
                    dprint("⚠️ Couldn't reach safe area, waiting anyway")
                end

                repeat task.wait() until #waves:GetChildren() == 0
                if not autoFarmBlock then break end

                if wavePlatform then
                    dprint("🗑️ Removing waveblocker...")
                    removePlatform(wavePlatform)
                    wavePlatform = nil
                end
            end

            task.wait(1)
        end
    end)
end

local function stopAutoFarm()
    autoFarmBlock = false
    farmConnection = nil
    isWalking = false

    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
end

