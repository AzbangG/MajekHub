--// ================= FUNCTIONS =================
local function getZones()
    local list = {}
    local folder = workspace:FindFirstChild("CollectZones")

    if folder then
        for _, v in pairs(folder:GetChildren()) do
            if v:IsA("BasePart") then
                table.insert(list, v.Name)
            end
        end
    end

    return list
end

local function getSelectedZone()
    if not selectedZone then return workspace.CollectZones.base15 end

    local folder = workspace:FindFirstChild("CollectZones")
    if not folder then return end

    return folder:FindFirstChild(selectedZone)
end

local function getTools()
    return player.Backpack:GetChildren()
end

local function getModel()
    local f = workspace:FindFirstChild("RunningModels")
    if not f then return end
    return f:FindFirstChild(tostring(player.UserId))
end

--// GET HRP
local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

--// GET HRP
local function getModelHRP(character)
    local char = character
    return char:WaitForChild("HumanoidRootPart")
end
 
--// TELEPORT
local function tp(part)
    local hrp = getHRP()
    if hrp and part then
        hrp.CFrame = part.CFrame + Vector3.new(0, 0, -5)
    end
end

local function startReward()
    if rewardThread then return end

    rewardThread = task.spawn(function()
        while autoReward do
            
            -- 🎁 CLAIM PLAYTIME
            for i = 1, 12 do
                pcall(function()
                    PlaytimeRF:InvokeServer(i)
                end)
            end
            print("[Reward] Claim Playtime...")

            -- 🎫 CLAIM PASS
            pcall(function()
                PassRF:InvokeServer()
            end)
            print("[Reward] Claim Pass...")

            -- ⏱ DELAY 60 DETIK (SMART BREAK)
            local t = 0
            while t < 60 do
                if not autoReward then break end
                task.wait(1)
                t += 1
            end
        end

        rewardThread = nil
    end)
end

local function stopReward()
    autoReward = false

    if rewardThread then
        task.cancel(rewardThread)
        rewardThread = nil
    end
end

--// ================= AUTO FARM (LIGHT LOOP) =================
local farmThread

local function startFarm()
    if farmThread then return end

    farmThread = task.spawn(function()
        while autoFarm do
            local shopFolder = workspace:FindFirstChild("TeleportParts")
            local shop = shopFolder and shopFolder:FindFirstChild("ShopTeleportPart")
            local line = workspace:FindFirstChild("Line")

            -- 🔹 1. TELEPORT KE LINE
            print("0. Teleport Lines")
            if line then
                tp(line)
            end

            task.wait(2)
            if not autoFarm then break end

            -- 🔹 2. AMBIL MODEL
            local m = getModel()

            if m then
                local zone = getSelectedZone()
                local hrp = getModelHRP(m)

                -- 🔹 3. JALANKAN FARM
                print("1. Runs")
				warn(zone.Name.."_1")

                if farmMode == "Move" then
					warn("farmMode-Move")
                    if m and hrp then
						warn("Move_Run-1")
                        m:SetAttribute("MovementSpeed", speed)

                        if zone then
							warn(zone.Name.."_2")
							warn("Move_Run-2")
                            local reached = false
                            local t = 0

                            while not reached and t < 7 and autoFarm do
                                local dist = (hrp.Position - zone.Position).Magnitude

                                if dist <= 35 then
                                    reached = true
                                    break
                                end

                                task.wait(0.1)
                                t += 0.1
                            end
						else
							warn("zone Lost")
                        end

                        m:SetAttribute("MovementSpeed", 0)
					else
						warn("Lost")
                    end
                elseif farmMode == "Teleport" then
					warn("farmMode-Teleport")
                    if not m.PrimaryPart then
						warn("Teleport_Run-1")
                        local part = m:FindFirstChildWhichIsA("BasePart")
                        if part then
                            m.PrimaryPart = part
                        end
                    end

                    if m.PrimaryPart then
					warn("Teleport_Run-2")
                        if zone then
							warn(zone.Name.."_3")
                            m:SetPrimaryPartCFrame(zone.CFrame + Vector3.new(0, -5, 0))
                        else
                            m:SetPrimaryPartCFrame(workspace.CollectZones.base15.CFrame + Vector3.new(0, -5, 0))
                        end

                        m:SetAttribute("MovementSpeed", 0)
                    end
                end

                -- 🔹 4. TUNGGU MODEL HILANG
                print("2. Wait Model Gone")
                while m and m.Parent and autoFarm do
                    task.wait(0.3)
                end

                if not autoFarm then break end

                -- 🔹 5. TUNGGU CUTSCENE MUNCUL
                print("3. Waiting CUTSCENE_FOLD appear")
                local cutscene
                while not cutscene and autoFarm do
                    cutscene = workspace:FindFirstChild("CUTSENE_FOLD")
                    task.wait(0.2)
                end

                -- 🔹 6. TUNGGU CUTSCENE HILANG
                print("4. Waiting CUTSCENE_FOLD disappear")
                while cutscene and cutscene.Parent and autoFarm do
                    task.wait(0.2)
                end
				wait(0.5)
            end

            if not autoFarm then break end

            -- 🔹 7. TELEPORT KE SHOP
            print("5. Teleport Shop")
            if shop then
                tp(shop)
            end

            task.wait(1)
        end

        farmThread = nil
    end)
end

local function stopFarm()
    autoFarm = false
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
end

AutoFarm:OnChanged(function(v)
    autoFarm = v

    if v  then
