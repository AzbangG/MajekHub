--// ================= FUNCTIONS =================

local function getZones()
    local list = {}
    local f = workspace:FindFirstChild("CollectZones")
    if f then
        for _,v in pairs(f:GetChildren()) do
            if v:IsA("BasePart") then
                table.insert(list, v.Name)
            end
        end
    end
    return list
end

local function getSelectedZone()
    if not selectedZone then return workspace.CollectZones.base15 end

    local f = workspace:FindFirstChild("CollectZones")
    if not f then return end

    return f:FindFirstChild(selectedZone)
end

local function getHRP()
    return (player.Character or player.CharacterAdded:Wait()):WaitForChild("HumanoidRootPart")
end

local function getModel()
    local f = workspace:FindFirstChild("RunningModels")
    return f and f:FindFirstChild(tostring(player.UserId))
end

local function getModelHRP(m)
    return m:WaitForChild("HumanoidRootPart")
end

local function tp(p)
    local hrp = getHRP()
    if hrp and p then
        hrp.CFrame = p.CFrame + Vector3.new(0,0,5)
    end
end

local function startReward()
    if rewardThread then return end

    rewardThread = task.spawn(function()
        while autoReward do
            
            -- 🎁 CLAIM PLAYTIME
            for i = 1, 12 do
                pcall(function()
                    PlaytimeRF:InvokeServer(i)
                end)
            end
            print("[Reward] Claim Playtime...")

            -- 🎫 CLAIM PASS
            pcall(function()
                PassRF:InvokeServer()
            end)
            print("[Reward] Claim Pass...")

            -- ⏱ DELAY 60 DETIK (SMART BREAK)
            local t = 0
            while t < 60 do
                if not autoReward then break end
                task.wait(1)
                t += 1
            end
        end

        rewardThread = nil
    end)
end

local function stopReward()
    autoReward = false

    if rewardThread then
        task.cancel(rewardThread)
        rewardThread = nil
    end
end

--// ================= AUTO REFRESH ZONE =================

local zoneCons = {}

local function clearZoneCons()
    for _,c in pairs(zoneCons) do
        c:Disconnect()
    end
    table.clear(zoneCons)
end

local function setupZoneRefresh()
    local function hook(folder)
        clearZoneCons()
        ZoneDropdown:SetValues(getZones())

        table.insert(zoneCons, folder.ChildAdded:Connect(function(c)
            if c:IsA("BasePart") then
                ZoneDropdown:SetValues(getZones())
            end
        end))

        table.insert(zoneCons, folder.ChildRemoved:Connect(function(c)
            if c:IsA("BasePart") then
                ZoneDropdown:SetValues(getZones())
            end
        end))
    end

    local f = workspace:FindFirstChild("CollectZones")
    if f then hook(f) end

    table.insert(zoneCons, workspace.ChildAdded:Connect(function(c)
        if c.Name == "CollectZones" then
            task.wait(0.2)
            hook(c)
        end
    end))
end

setupZoneRefresh()

