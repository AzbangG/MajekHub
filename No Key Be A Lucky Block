--// WALK TO POSITION
local function walkToPositionDetect(targetPos, timeoutDuration, label)
    label = label or "Target"
    timeoutDuration = timeoutDuration or 10
    
    if isWalking then
        return false
    end
    
    local char = player.Character
    if not char then 
        return false 
    end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then 
        return false 
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        return false 
    end
    
    isWalking = true
    humanoid.WalkSpeed = walkSpeed
    
    local startTime = tick()
    local maxRetries = 3
    local currentRetry = 0
    
    while currentRetry < maxRetries do
        currentRetry = currentRetry + 1
        
        local path = nil
        local success = pcall(function()
            path = PathfindingService:FindPathAsync(hrp.Position, targetPos)
        end)
        
        if success and path then
            local waypoints = path:GetWaypoints()
            local blocked = false
            
            local blockedConn = path.Blocked:Connect(function(blockedWaypoint)
                blocked = true
            end)
            
            local pathSuccess = true
            
            for i, waypoint in ipairs(waypoints) do
                if not isWalking or tick() - startTime > timeoutDuration then
                    blockedConn:Disconnect()
                    pathSuccess = false
                    break
                end
                
                humanoid:MoveTo(waypoint.Position)
                
                local reached = false
                for j = 1, 100 do
                    if not isWalking then break end
                    
                    local dist = (hrp.Position - waypoint.Position).Magnitude
                    if dist < 5 then
                        reached = true
                        break
                    end
                    
                    if blocked then
                        break
                    end
                    
                    task.wait(0.1)
                end
                
                if blocked or not reached then
                    pathSuccess = false
                    break
                end
            end
            
            blockedConn:Disconnect()
            
            if pathSuccess then
                local finalDistance = (hrp.Position - targetPos).Magnitude
                
                if finalDistance < 5 then
                    isWalking = false
                    return true
                end
            end
        else
            if currentRetry < maxRetries then
                task.wait(1)
            end
        end
        
        if currentRetry >= maxRetries then
            humanoid:MoveTo(targetPos)
            task.wait(0.5)
            
            while tick() - startTime < timeoutDuration do
                local dist = (hrp.Position - targetPos).Magnitude
                if dist < 5 then
                    isWalking = false
                    return true
                end
                task.wait(0.1)
            end
            
            isWalking = false
            return false
        end
    end
    
    isWalking = false
    return false
end

--// WAVEBLOCKER
local function createWaveblocker(root)
    if not root or not root.Parent then 
        return nil 
    end
    
    local rootSize = root.Size
    
    local waveblocker = Instance.new("Part")
    waveblocker.Name = "Waveblocker"
    waveblocker.Size = Vector3.new(rootSize.X + 30, rootSize.Y + 50, rootSize.Z + 100)
    waveblocker.CanCollide = true
    waveblocker.Transparency = 1
    waveblocker.CFrame = root.CFrame
    waveblocker.Parent = workspace
    
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = waveblocker
    weld.Parent = waveblocker
    
    return waveblocker
end

local function removePlatform(platform)
    if platform and platform.Parent then
        platform:Destroy()
    end
end

--// AUTO FARM
local wavePlatform = nil

local function startAutoFarm()
    if farmConnection then return end
    
    farmConnection = task.spawn(function()
        local waves = workspace:WaitForChild("Waves")
        
        while autoFarmBlock do
            walkToPositionDetect(kickCF.Position, 5, "Kick Area")
            
            local kickBtn = playerGui:WaitForChild("HUD"):WaitForChild("KickButton")
            if kickBtn and getconnections then
                pcall(function() for _, conn in pairs(getconnections(kickBtn.Activated)) do conn:Fire() end end)
            end
            
            local newWave
            local conn
            conn = waves.ChildAdded:Connect(function(child)
                newWave = child
            end)
            repeat task.wait() until newWave or not autoFarmBlock
            if conn then conn:Disconnect() end
            if not autoFarmBlock then break end
            
            task.wait(0.05)
            
            local root
            if newWave:IsA("Model") then
                root = newWave:FindFirstChild("Root")
                    or newWave.PrimaryPart
            elseif newWave:IsA("BasePart") then
                root = newWave
            end
            
            if root then
                if wavePlatform then
                    removePlatform(wavePlatform)
                    wavePlatform = nil
                end
                
                wavePlatform = createWaveblocker(root)
                
                walkToPositionDetect(KickArea.Position, 18, "Safe Area (KickArea)")
                
                repeat task.wait() until #waves:GetChildren() == 0
                if not autoFarmBlock then break end
                
                if wavePlatform then
                    removePlatform(wavePlatform)
                    wavePlatform = nil
                end
            end
            
            task.wait(1)
        end
    end)
end

local function stopAutoFarm()
    autoFarmBlock = false
    farmConnection = nil
    isWalking = false
    
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
end

