-- ─────────────────────────────────────────────
--  Helper: Check if a player holds a role tool
--  Searches both Backpack AND Character children
-- ─────────────────────────────────────────────
local function hasToolMatching(player, keywords)
    local character = player.Character
    local backpack  = player:FindFirstChildOfClass("Backpack")

    local function checkContainer(container)
        if not container then return false end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                for _, kw in ipairs(keywords) do
                    if name:find(kw:lower(), 1, true) then
                        return true
                    end
                end
            end
        end
        return false
    end

    return checkContainer(character) or checkContainer(backpack)
end

-- ─────────────────────────────────────────────
--  ESP Highlight Management
-- ─────────────────────────────────────────────
local espHighlights = {}  -- [player] = Highlight

local function removeESP(player)
    if espHighlights[player] then
        espHighlights[player]:Destroy()
        espHighlights[player] = nil
    end
end

local function applyESP(player, color)
    if player == LocalPlayer then return end
    local character = player.Character
    if not character then return end

    local hl = espHighlights[player]
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight")
        hl.Name    = "MurderESP_Highlight"
        hl.Adornee = character
        hl.Parent  = character
        espHighlights[player] = hl
    end

    hl.FillColor           = color
    hl.OutlineColor        = color
    hl.FillTransparency    = 0.55
    hl.OutlineTransparency = 0
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
end

-- ─────────────────────────────────────────────
--  BillboardGui Name Tag
-- ─────────────────────────────────────────────
local espBillboards = {}  -- [player] = BillboardGui

local function removeBillboard(player)
    if espBillboards[player] then
        espBillboards[player]:Destroy()
        espBillboards[player] = nil
    end
end

local function applyBillboard(player, label, color)
    if player == LocalPlayer then return end
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bb = espBillboards[player]
    if not bb or not bb.Parent then
        bb = Instance.new("BillboardGui")
        bb.Name         = "MurderESP_Billboard"
        bb.Adornee      = hrp
        bb.Size         = UDim2.new(0, 130, 0, 40)
        bb.StudsOffset  = Vector3.new(0, 3.5, 0)
        bb.AlwaysOnTop  = true
        bb.ResetOnSpawn = false
        bb.Parent       = character

        local frame = Instance.new("Frame", bb)
        frame.Size                   = UDim2.fromScale(1, 1)
        frame.BackgroundColor3       = Color3.new(0, 0, 0)
        frame.BackgroundTransparency = 0.5
        frame.BorderSizePixel        = 0
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local txt = Instance.new("TextLabel", frame)
        txt.Name                    = "RoleLabel"
        txt.Size                    = UDim2.fromScale(1, 1)
        txt.BackgroundTransparency  = 1
        txt.Font                    = Enum.Font.GothamBold
        txt.TextScaled              = true
        txt.TextStrokeTransparency  = 0.4

        espBillboards[player] = bb
    end

    local frame = bb:FindFirstChildOfClass("Frame")
    if frame then
        local txt = frame:FindFirstChild("RoleLabel")
        if txt then
            txt.Text       = string.format("[%s] %s", label, player.DisplayName)
            txt.TextColor3 = color
        end
    end
end

-- ─────────────────────────────────────────────
--  Core ESP Update Loop
--  Priority: Murder > Sheriff > Innocent
--  Innocent = player yang tidak punya knife/gun
-- ─────────────────────────────────────────────
local function updateESP()
    local anyEnabled = ESPConfig.Murder.Enabled
        or ESPConfig.Sheriff.Enabled
        or ESPConfig.Innocent.Enabled

    if not anyEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end

        local isMurder  = hasToolMatching(player, ESPConfig.Murder.Keywords)
        local isSheriff = hasToolMatching(player, ESPConfig.Sheriff.Keywords)

        if ESPConfig.Murder.Enabled and isMurder then
            applyESP(player, ESPConfig.Murder.Color)
            applyBillboard(player, "MURDER", ESPConfig.Murder.Color)

        elseif ESPConfig.Sheriff.Enabled and isSheriff then
            applyESP(player, ESPConfig.Sheriff.Color)
            applyBillboard(player, "SHERIFF", ESPConfig.Sheriff.Color)

        elseif ESPConfig.Innocent.Enabled and (not isMurder) and (not isSheriff) then
            -- Innocent: bukan murder dan bukan sheriff
            applyESP(player, ESPConfig.Innocent.Color)
            applyBillboard(player, "INNOCENT", ESPConfig.Innocent.Color)

        else
            -- Toggle yang relevan tidak aktif untuk role player ini → hapus
            removeESP(player)
            removeBillboard(player)
        end
    end
end

-- Bersihkan saat player leave / respawn
Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
    removeBillboard(player)
end)

Players.PlayerAdded:Connect(function(player)
    player.CharacterRemoving:Connect(function()
        removeESP(player)
        removeBillboard(player)
    end)
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterRemoving:Connect(function()
            removeESP(player)
            removeBillboard(player)
        end)
    end
end

-- Heartbeat loop
RunService.Heartbeat:Connect(updateESP)

-- ─────────────────────────────────────────────
--  GunDrop ESP
--  Deteksi: Model di Workspace dengan Attribute
--  "MapID" → pantau ChildAdded "GunDrop"
-- ─────────────────────────────────────────────
local gunDropHighlights = {}  -- [instance] = Highlight
local gunDropBillboards = {}  -- [instance] = BillboardGui
local mapConnections    = {}  -- [model]    = RBXScriptConnection

local function removeGunDropESP(obj)
    if gunDropHighlights[obj] then
        gunDropHighlights[obj]:Destroy()
        gunDropHighlights[obj] = nil
    end
    if gunDropBillboards[obj] then
        gunDropBillboards[obj]:Destroy()
        gunDropBillboards[obj] = nil
    end
end

local function applyGunDropESP(obj)
    if not ESPConfig.GunDrop.Enabled then return end
    if not obj or not obj.Parent then return end

    -- Highlight
    local hl = gunDropHighlights[obj]
    if not hl or not hl.Parent then
        hl = Instance.new("Highlight")
        hl.Name                = "GunDropESP_Highlight"
        hl.Adornee             = obj
        hl.FillColor           = ESPConfig.GunDrop.Color
        hl.OutlineColor        = ESPConfig.GunDrop.Color
        hl.FillTransparency    = 0.4
        hl.OutlineTransparency = 0
        hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent              = obj
        gunDropHighlights[obj] = hl
    else
        hl.FillColor    = ESPConfig.GunDrop.Color
        hl.OutlineColor = ESPConfig.GunDrop.Color
    end

    -- BillboardGui
    local anchor = obj:IsA("BasePart") and obj
        or obj:FindFirstChildWhichIsA("BasePart", true)
    if not anchor then return end

    local bb = gunDropBillboards[obj]
    if not bb or not bb.Parent then
        bb = Instance.new("BillboardGui")
        bb.Name         = "GunDropESP_Billboard"
        bb.Adornee      = anchor
        bb.Size         = UDim2.new(0, 110, 0, 36)
        bb.StudsOffset  = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop  = true
        bb.ResetOnSpawn = false
        bb.Parent       = obj

        local frame = Instance.new("Frame", bb)
        frame.Size                   = UDim2.fromScale(1, 1)
        frame.BackgroundColor3       = Color3.new(0, 0, 0)
        frame.BackgroundTransparency = 0.45
        frame.BorderSizePixel        = 0
        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

        local txt = Instance.new("TextLabel", frame)
        txt.Name                   = "DropLabel"
        txt.Size                   = UDim2.fromScale(1, 1)
        txt.BackgroundTransparency = 1
        txt.Font                   = Enum.Font.GothamBold
        txt.Text                   = "🔫 GUN DROP"
        txt.TextColor3             = ESPConfig.GunDrop.Color
        txt.TextScaled             = true
        txt.TextStrokeTransparency = 0.4

        gunDropBillboards[obj] = bb
    else
        local frame = bb:FindFirstChildOfClass("Frame")
        if frame then
            local txt = frame:FindFirstChild("DropLabel")
            if txt then txt.TextColor3 = ESPConfig.GunDrop.Color end
        end
    end
end

local function scanMapForGunDrops(mapModel)
    for _, child in ipairs(mapModel:GetChildren()) do
        if child.Name == "GunDrop" then
            applyGunDropESP(child)
            child.AncestryChanged:Connect(function(_, newParent)
                if not newParent then removeGunDropESP(child) end
            end)
        end
    end
end

local function hookMapModel(mapModel)
    if mapConnections[mapModel] then return end

    scanMapForGunDrops(mapModel)

    mapConnections[mapModel] = mapModel.ChildAdded:Connect(function(child)
        if child.Name == "GunDrop" then
            task.defer(function()
                applyGunDropESP(child)
                child.AncestryChanged:Connect(function(_, newParent)
                    if not newParent then removeGunDropESP(child) end
                end)
            end)
        end
    end)

    mapModel.AncestryChanged:Connect(function(_, newParent)
        if not newParent then
            if mapConnections[mapModel] then
                mapConnections[mapModel]:Disconnect()
                mapConnections[mapModel] = nil
            end
            for _, child in ipairs(mapModel:GetChildren()) do
                removeGunDropESP(child)
            end
        end
    end)
end

local function findAndHookMaps()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj:GetAttribute("MapID") ~= nil then
            hookMapModel(obj)
        end
    end
end

workspace.ChildAdded:Connect(function(obj)
    if obj:IsA("Model") and obj:GetAttribute("MapID") ~= nil then
        task.defer(function() hookMapModel(obj) end)
    end
end)

findAndHookMaps()

local function clearAllGunDropESP()
    for obj in pairs(gunDropHighlights) do
        removeGunDropESP(obj)
    end
end

local function refreshGunDropColors()
    for obj, hl in pairs(gunDropHighlights) do
        if hl and hl.Parent then
            hl.FillColor    = ESPConfig.GunDrop.Color
            hl.OutlineColor = ESPConfig.GunDrop.Color
        end
        local bb = gunDropBillboards[obj]
        if bb and bb.Parent then
            local frame = bb:FindFirstChildOfClass("Frame")
            if frame then
                local txt = frame:FindFirstChild("DropLabel")
                if txt then txt.TextColor3 = ESPConfig.GunDrop.Color end
            end
        end
    end
end

