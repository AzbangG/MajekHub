--// FUNGSI WALK DETECT - FIX BERHENTI SEBELUM TUJUAN
local function walkToPositionDetect(targetPos, timeoutDuration, label)
    label = label or "Target"
    timeoutDuration = timeoutDuration or 10
    
    local char = player.Character
    if not char then 
        print("❌ " .. label .. ": Character not found")
        return false 
    end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then 
        print("❌ " .. label .. ": Humanoid not found")
        return false 
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then 
        print("❌ " .. label .. ": HRP not found")
        return false 
    end
    
    print("🚶 Walking to " .. label .. "...")
    
    local startTime = tick()
    local stuckTimeout = 0
    local lastPos = hrp.Position
    
    while tick() - startTime < timeoutDuration do
        local distance = (hrp.Position - targetPos).Magnitude
        
        -- Jika sudah dekat, selesai
        if distance < 5 then
            print("✅ Arrived at " .. label .. " (distance: " .. math.floor(distance) .. " studs)")
            return true
        end
        
        -- PENTING: Call MoveTo terus-menerus setiap loop agar tidak berhenti
        humanoid:MoveTo(targetPos)
        
        task.wait(0.1)
        
        -- Check jika character stuck (not moving for 2 seconds)
        local currentPos = hrp.Position
        if (currentPos - lastPos).Magnitude < 0.5 then
            stuckTimeout = stuckTimeout + 0.1
            if stuckTimeout > 2 then
                print("⚠️ " .. label .. ": Character stuck, retrying...")
                stuckTimeout = 0
            end
        else
            stuckTimeout = 0
        end
        lastPos = currentPos
    end
    
    print("⏱️ Timeout at " .. label .. " (distance: " .. math.floor((hrp.Position - targetPos).Magnitude) .. " studs)")
    return false
end

--// FUNGSI BUAT WAVEBLOCKER
local function createWaveblocker(root)
    if not root or not root.Parent then 
        print("❌ Wave root not found")
        return nil 
    end
    
    local rootSize = root.Size
    
    local waveblocker = Instance.new("Part")
    waveblocker.Name = "Waveblocker"
    waveblocker.Size = Vector3.new(rootSize.X + 30, rootSize.Y + 50, rootSize.Z + 100) -- z=depan/belakang
    waveblocker.CanCollide = true
    waveblocker.Transparency = 1
    waveblocker.CFrame = root.CFrame
    waveblocker.Parent = workspace
    
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = waveblocker
    weld.Parent = waveblocker
    
    print("📦 Waveblocker created, size: " .. tostring(waveblocker.Size))
    return waveblocker
end

local function removePlatform(platform)
    if platform and platform.Parent then
        platform:Destroy()
    end
end

--// AUTO FARM FUNCTION
local wavePlatform = nil

local function startAutoFarm()
    if farmConnection then return end
    
    farmConnection = task.spawn(function()
        local waves = workspace:WaitForChild("Waves")
        
        while autoFarmBlock do
            -- Walk ke kickCF dan detect sampai
            if walkToPositionDetect(kickCF.Position, 5, "Kick Area") then
                print("✅ Ready to kick!")
            else
                print("⚠️ Couldn't reach kick area, proceeding anyway")
            end
            
            -- Fire kick button
            local kickBtn = playerGui:WaitForChild("HUD"):WaitForChild("KickButton")
            if kickBtn and getconnections then
                pcall(function() for _, conn in pairs(getconnections(kickBtn.Activated)) do conn:Fire() end end)
            end
            
            -- Tunggu wave muncul
            local newWave
            local conn
            conn = waves.ChildAdded:Connect(function(child)
                newWave = child
            end)
            repeat task.wait() until newWave or not autoFarmBlock
            if conn then conn:Disconnect() end
            if not autoFarmBlock then break end
            
            task.wait(0.05)
            
            local root
            if newWave:IsA("Model") then
                root = newWave:FindFirstChild("Root")
                    or newWave.PrimaryPart
            elseif newWave:IsA("BasePart") then
                root = newWave
            end
            
            if root then
                -- Hapus waveblocker lama jika masih ada (CEGAH DUPLIKAT)
                if wavePlatform then
                    print("🗑️ Cleaning up old waveblocker before creating new one...")
                    removePlatform(wavePlatform)
                    wavePlatform = nil
                end
                
                -- Buat waveblocker baru
                wavePlatform = createWaveblocker(root)
                
                -- Walk ke KickArea (bukan ke waveblocker)
                if walkToPositionDetect(KickArea.Position, 18, "Safe Area (KickArea)") then
                    print("✅ Standing in safe area!")
                else
                    print("⚠️ Couldn't reach safe area, waiting anyway")
                end
                
                -- Tunggu wave habis
                repeat task.wait() until #waves:GetChildren() == 0
                if not autoFarmBlock then break end
                
                -- Hapus waveblocker setelah wave habis
                if wavePlatform then
                    print("🗑️ Removing waveblocker...")
                    removePlatform(wavePlatform)
                    wavePlatform = nil
                end
            end
            
            task.wait(1)
        end
    end)
end

local function stopAutoFarm()
    autoFarmBlock = false
    farmConnection = nil
    
