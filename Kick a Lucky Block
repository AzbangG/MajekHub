--// STATE
local autoClickBonus = false
local bonusConnections = {}
local autoKick = false
local kickConnection = nil
local autoFarmBlock = false
local farmConnection = nil

local kickCF = CFrame.new(
    695.58844, 3.00000691, 231.934326,
    0.0143117635, 7.11090031e-09, 0.999897599,
    7.17339077e-09, 1, -7.21430293e-09,
