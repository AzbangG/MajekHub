local function setupBonusAutoClick()
    clearConnections()

    local kickGui = playerGui:WaitForChild("KickUpgrades")

    local function hookBonus(button)
        if not button:IsA("GuiButton") then return end

        local conn = button:GetPropertyChangedSignal("Visible"):Connect(function()
            if autoClickBonus and button.Visible then
                task.wait(0.1)
                pcall(function()
                    clickButton(button)
                end)
            end
        end)

        table.insert(bonusConnections, conn)

        -- kalau sudah visible
        if autoClickBonus and button.Visible then
            task.wait(0.1)
            pcall(function()
                clickButton(button)
            end)
        end
    end

    for _, v in ipairs(kickGui:GetDescendants()) do
        if v.Name == "Bonus" then
            hookBonus(v)
        end
    end

    local addedConn = kickGui.DescendantAdded:Connect(function(v)
        if v.Name == "Bonus" then
            task.wait()
            hookBonus(v)
        end
    end)

    table.insert(bonusConnections, addedConn)
end

local function startAutoKick()
    if kickConnection then return end
    
    kickConnection = task.spawn(function()
        while autoKick do
            pcall(function()
                local char = player.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    
                    if hrp then
                        -- Cek jarak ke KickArea
                        local kickArea = workspace:WaitForChild("Areas"):WaitForChild("KickReady")
                        local distance = (hrp.Position - kickArea.Position).Magnitude
                        
                        -- Kalau dekat dengan KickArea (threshold 50)
                        if distance < 50 then
                            if not _G.__kickDebounce then
                                _G.__kickDebounce = true
                                
                                local args = getRandomArgs()
                                KickRE:FireServer(unpack(args))
                                print(unpack(args))
                                
                                task.delay(0.3, function()
                                    _G.__kickDebounce = false
                                end)
                            end
                        end
                    end
                end
            end)
            
            task.wait(0.1) -- Delay 0.1 detik agar tidak freeze
        end
    end)
end

local function stopAutoKick()
    autoKick = false
    kickConnection = nil
end

local function startAutoFarm()
    if farmConnection then return end
    
    farmConnection = task.spawn(function()
        local waves = workspace:WaitForChild("Waves")
        
        while autoFarmBlock do
            -- Tween ke kickCF
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    tweenToPosition(hrp, kickCF, tweenSpeed)
                    task.wait(tweenSpeed + 0.1) -- Tunggu tween selesai
                end
            end
            
            local args = getRandomArgs()
            KickRE:FireServer(unpack(args))
            print(unpack(args))
            
            local newWave
            local conn
            conn = waves.ChildAdded:Connect(function(child)
                newWave = child
            end)
            repeat task.wait() until newWave or not autoFarmBlock
            if conn then conn:Disconnect() end
            if not autoFarmBlock then break end
            
            task.wait(0.05)
            
            local root
            if newWave:IsA("Model") then
                root = newWave:FindFirstChild("Root")
                    or newWave.PrimaryPart
            elseif newWave:IsA("BasePart") then
                root = newWave
            end
            
            if root then
                task.wait(5)
                -- Tween ke kickCF lagi
                local char = player.Character
                if char then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        tweenToPosition(hrp, kickCF, tweenSpeed)
                        task.wait(tweenSpeed + 0.1)
                    end
                end
                
                -- Spawn connection terpisah untuk spam CollectRE
                local collectSpammer = task.spawn(function()
                    while autoFarmBlock and #waves:GetChildren() > 0 do
                        pcall(function()
                            CollectRE:FireServer()
                        end)
                        task.wait(0.1)
                    end
                end)
            end
            
            repeat task.wait() until #waves:GetChildren() == 0 or not autoFarmBlock
            if not autoFarmBlock then break end
            task.wait(3)
        end
    end)
end
 
local function stopAutoFarm()
    autoFarmBlock = false
    farmConnection = nil
    
    -- Cancel tween kalau lagi berjalan
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
end

AutoClick:OnChanged(function(v)
    autoClickBonus = v
