--// FUNCTION AUTO CLICK BONUS
local function clearConnections()
    for _, conn in ipairs(bonusConnections) do
        if conn and conn.Disconnect then
            conn:Disconnect()
        end
    end
    table.clear(bonusConnections)
end

local function clickCenterScreen()
    local camera = workspace.CurrentCamera
    local viewport = camera.ViewportSize

    local x = viewport.X / 2
    local y = viewport.Y / 2

    -- klik tengah layar
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function teleport(cf)
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = cf
    end
end

local function setupBonusAutoClick()
    clearConnections()

    local kickGui = playerGui:WaitForChild("KickUpgrades")

    local function clickBonus(button)
        task.spawn(function()
            task.wait(0.2)
            local imgLabel = button:FindFirstChild("ImageLabel")
            local targets = {button}
            if imgLabel then table.insert(targets, imgLabel) end

            if getconnections then
                for _, target in pairs(targets) do
                    pcall(function()
                        for _, conn in pairs(getconnections(target.InputBegan)) do
                            conn:Fire({UserInputType = Enum.UserInputType.MouseButton1, UserInputState = Enum.UserInputState.Begin})
                            conn:Fire({UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.Begin})
                        end
                    end)
                    pcall(function() for _, conn in pairs(getconnections(target.MouseButton1Down)) do conn:Fire() end end)
                    pcall(function() for _, conn in pairs(getconnections(target.MouseButton1Up)) do conn:Fire() end end)
                    pcall(function() for _, conn in pairs(getconnections(target.MouseButton1Click)) do conn:Fire() end end)
                    pcall(function() for _, conn in pairs(getconnections(target.Activated)) do conn:Fire() end end)
                end
            end
        end)
    end

    local function hookBonus(button)
        if button.Name ~= "Bonus" and button.Name ~= "PopBonus" then return end

        if button.Visible then
            if not button:GetAttribute("AutoClicked") then
                button:SetAttribute("AutoClicked", true)
                clickBonus(button)
            end
        else
            button:SetAttribute("AutoClicked", nil)
        end
    end

    for _, v in ipairs(kickGui:GetDescendants()) do
        hookBonus(v)
    end

    local addedConn = kickGui.DescendantAdded:Connect(function(v)
        task.wait()
        hookBonus(v)
    end)

    table.insert(bonusConnections, addedConn)
end

local function startAutoKick()
    local movingBar = playerGui:WaitForChild("KickMinigame")
        :WaitForChild("Bar")
        :WaitForChild("MovingBar")

    kickConnection = movingBar:GetPropertyChangedSignal("Size"):Connect(function()
        if not autoKick then return end

        local size = movingBar.Size

        -- langsung klik tanpa delay
        if size.X.Scale >= 1 and size.Y.Scale >= 1 then
            clickCenterScreen()
        end
    end)
end

local function stopAutoKick()
    if kickConnection then
        kickConnection:Disconnect()
        kickConnection = nil
    end
end

--// GANTI walkTo function
local function walkToPosition(targetPos)
    local char = player.Character
    if not char then return end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if humanoid then
        humanoid:MoveTo(targetPos)
    end
end

--// GANTI createWavePlatform - jangan teleport, buat saja
local function createWavePlatform(root)
    if not root or not root.Parent then return nil end
    
    local safePlatform = Instance.new("Part")
    safePlatform.Name = "SafePlatform"
    safePlatform.Size = Vector3.new(120, 100, 130)
    safePlatform.CanCollide = true
    safePlatform.Transparency = 1
    safePlatform.CFrame = root.CFrame + (root.CFrame.LookVector * 50)
    safePlatform.Parent = workspace
    
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = safePlatform
    weld.Parent = safePlatform
    
    return safePlatform
end

local function removePlatform(platform)
    if platform and platform.Parent then
        platform:Destroy()
    end
end

--// UPDATE startAutoFarm
local wavePlatform = nil

local function startAutoFarm()
    if farmConnection then return end
    
    farmConnection = task.spawn(function()
        local waves = workspace:WaitForChild("Waves")
        
        while autoFarmBlock do
            -- Walk ke kickCF menggunakan humanoid
            walkToPosition(kickCF.Position)
            task.wait(3) -- Tunggu sampai
            
            local kickBtn = playerGui:WaitForChild("HUD"):WaitForChild("KickButton")
            if kickBtn and getconnections then
                pcall(function() for _, conn in pairs(getconnections(kickBtn.Activated)) do conn:Fire() end end)
            end
            
            -- Tunggu wave muncul
            local newWave
            local conn
            conn = waves.ChildAdded:Connect(function(child)
                newWave = child
            end)
            repeat task.wait() until newWave or not autoFarmBlock
            if conn then conn:Disconnect() end
            if not autoFarmBlock then break end
            
            task.wait(0.05)
            
            local root
            if newWave:IsA("Model") then
                root = newWave:FindFirstChild("Root")
                    or newWave.PrimaryPart
            elseif newWave:IsA("BasePart") then
                root = newWave
            end
            
            if root then
                -- Buat platform aman di depan wave (gak teleport ke situ)
                wavePlatform = createWavePlatform(root)
                
                walkToPosition(workspace.Lobby.Safe.Position)
                task.wait(0.5) -- Tunggu character position
                
                -- Tunggu wave habis
                repeat task.wait() until #waves:GetChildren() == 0 or not autoFarmBlock
                if not autoFarmBlock then break end
                
                -- Hapus platform
                removePlatform(wavePlatform)
                wavePlatform = nil
            end
            
            task.wait(1)
        end
    end)
end

local function stopAutoFarm()
    autoFarmBlock = false
    farmConnection = nil
    
    if wavePlatform then
        removePlatform(wavePlatform)
        wavePlatform = nil
    end
    
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
end

