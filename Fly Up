            Title = "Magnet ON",
            Content = "Mode: " .. magnetMode .. " | Radius: " .. MAGNET_RADIUS .. " studs",
            Duration = 3
        })
    else
        stopMagnet()
        Fluent:Notify({
            Title = "Magnet OFF",
            Content = "Magnet dinonaktifkan",
            Duration = 3
        })
    end
end)

Tabs.Main:AddDropdown("MagnetMode", {
    Title = "Magnet Mode",
    Values = {"Instant", "Tween"},
    Default = "Tween"
}):OnChanged(function(v)
    magnetMode = v
    -- Restart loop agar pakai mode baru
    if AutoMagnet then
        stopMagnet()
        startMagnet()
    end
    Fluent:Notify({
        Title = "Mode Diganti",
        Content = "Magnet mode: " .. v,
        Duration = 2
    })
end)

