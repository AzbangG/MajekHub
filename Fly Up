--// ===============================================================
--//  UI – Toggle Auto Speed
--// ===============================================================
local SpeedToggle = Tabs.Main:AddToggle("SpeedToggle", {
    Title = "Auto Speed (R2)",
    Default = false
})

SpeedToggle:OnChanged(function(v)
    AutoSpeed = v
    if AutoSpeed then
        startAutoSpeed()
        Fluent:Notify({
            Title = "Auto Speed ON",
            Content = "Spam R2 aktif | Interval: " .. (R2_INTERVAL * 1000) .. "ms",
            Duration = 3
        })
    else
        stopAutoSpeed()
        Fluent:Notify({
            Title = "Auto Speed OFF",
            Content = "Spam R2 dinonaktifkan",
            Duration = 3
        })
    end
end)

-- Slider opsional untuk atur kecepatan spam
Tabs.Main:AddSlider("SpeedInterval", {
    Title = "Speed Interval",
    Min = 1,
    Max = 200,
    Default = 50,
    Suffix = " ms"
}):OnChanged(function(v)
