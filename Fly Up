--//  UI
--// ===============================================================
local MagnetToggle = Tabs.Main:AddToggle("MagnetToggle", {
    Title = "Toggle Magnet",
    Default = false
})

MagnetToggle:OnChanged(function(v)
    AutoMagnet = v
    if AutoMagnet then
        startMagnet()
