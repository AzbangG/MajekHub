    TrollDropdown:SetValues(list)
    FlingSingleDropdown:SetValues(list)
    FlingMultiDropdown:SetValues(list)
end

local function addHighlight(model)
    if counterHighlights[model] then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.3
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = model
    hl.Parent = model

    counterHighlights[model] = hl
end

local function addHunterHighlight(model)
    if hunterHighlights[model] then return end

    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(0, 170, 255) -- 🔵 biru
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.3
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = model
    hl.Parent = model

    hunterHighlights[model] = hl
end

local function removeHunterHighlight(model)
    if hunterHighlights[model] then
        hunterHighlights[model]:Destroy()
        hunterHighlights[model] = nil
    end
end

local function removeHighlight(model)
    if counterHighlights[model] then
        counterHighlights[model]:Destroy()
        counterHighlights[model] = nil
    end
end

