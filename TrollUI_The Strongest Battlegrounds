--// GET HRP
local function getTrollTargetHRP()
    if not trollTargetName then return end

    local target = Players:FindFirstChild(trollTargetName)
    if not target then return end

    local char = target.Character
    if not char then return end

    return char:FindFirstChild("HumanoidRootPart")
end

--// PLAYER LIST
local function getPlayerList()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(list, p.Name)
        end
    end
    return list
end

local function hasCounter(model)
    if model:FindFirstChild("Counter", true) then
        return true
    end
    return false
end

local function hasHunterCounter(model)
    return model:FindFirstChild("HunterCounter", true) ~= nil
end

--// GET HRP 
local function getHRP()
	local char = player.Character or player.CharacterAdded:Wait()
	return char:WaitForChild("HumanoidRootPart")
end

--// AUTO UPDATE PLAYER LIST
local function refreshPlayers()
