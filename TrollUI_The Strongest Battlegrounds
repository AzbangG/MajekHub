local function hasCounter(model)
    return model:FindFirstChild("Counter", true) ~= nil
end

local function hasHunterCounter(model)
    return model:FindFirstChild("HunterCounter", true) ~= nil
end

local function hasAtomicCounter(model)
    return model:FindFirstChild("AtomicCounter", true) ~= nil
end

local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function findLockOnTarget()
    local char = player.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local nearest = nil
    local nearestDist = math.huge

    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer == player then continue end

        local otherChar = otherPlayer.Character
        if not otherChar then continue end

        local humanoid = otherChar:FindFirstChildOfClass("Humanoid")
        local otherRoot = otherChar:FindFirstChild("HumanoidRootPart")

        if not humanoid or not otherRoot then continue end
        if humanoid.Health <= 0 then continue end

        local dist = (otherRoot.Position - myRoot.Position).Magnitude
        if dist < nearestDist then
            nearestDist = dist
            nearest = otherChar
        end
    end

    return nearest
end

local function startLockOn(targetChar)
    local camera = workspace.CurrentCamera
    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")

    if not humanoid or not targetRoot then return end

    lockOnTarget = targetChar
    lockOnEnabled = true

    -- Simpan subject asli sebelum diganti
    defaultSubject = camera.CameraSubject

    -- Arahkan kamera ke humanoid target (tetap Custom mode)
    camera.CameraSubject = humanoid

    -- Monitor jika target mati / keluar
    lockOnConn = RunService.RenderStepped:Connect(function()
    if not lockOnEnabled then return end

    local hum = lockOnTarget and lockOnTarget:FindFirstChildOfClass("Humanoid")
    local root = lockOnTarget and lockOnTarget:FindFirstChild("HumanoidRootPart")

    if not hum or not root or hum.Health <= 0 or not lockOnTarget.Parent then
        stopLockOn()
        return
    end

    local camera = workspace.CurrentCamera
    local currentCF = camera.CFrame

    local camOffset = currentCF.LookVector * -10 + Vector3.new(0, 3, 0)
    local newPosition = root.Position + camOffset

    local smoothPosition = currentCF.Position:Lerp(newPosition, 0.2)

    camera.CFrame = CFrame.new(smoothPosition, root.Position + Vector3.new(0, 1.5, 0))
	end)
end

function stopLockOn()
    lockOnEnabled = false
    lockOnTarget = nil

    if lockOnConn then
        lockOnConn:Disconnect()
        lockOnConn = nil
    end

    -- Kembalikan CameraSubject ke humanoid karakter sendiri
    local camera = workspace.CurrentCamera
    local myChar = player.Character
    local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")

    camera.CameraSubject = myHumanoid or defaultSubject
    defaultSubject = nil
end

