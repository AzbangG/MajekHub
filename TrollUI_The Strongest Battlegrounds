--// TROLL LOOP
local function startTroll()
    if trollConn then return end
    trollConn = RunService.RenderStepped:Connect(function()
        if not trollEnabled then return end
        local myHRP = getHRP()
        local targetHRP = getTrollTargetHRP()
        if myHRP and targetHRP then
            local targetCF = targetHRP.CFrame * CFrame.new(0, 0, 3)
            myHRP.CFrame = myHRP.CFrame:Lerp(targetCF, 0.6)
        end
    end)
end

local function stopTroll()
    trollEnabled = false
    if trollConn then
        trollConn:Disconnect()
        trollConn = nil
    end
end

TrollToggle:OnChanged(function(v)
    trollEnabled = v
    if v then startTroll() else stopTroll() end
end)

--// FLING
local function SkidFling(TargetPlayer)
    local Character = player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart

    local TCharacter = TargetPlayer.Character
    if not TCharacter then return end

    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local TRootPart = THumanoid and THumanoid.RootPart
    local THead = TCharacter:FindFirstChild("Head")
    local Accessory = TCharacter:FindFirstChildOfClass("Accessory")
    local Handle = Accessory and Accessory:FindFirstChild("Handle")

    if not (Character and Humanoid and RootPart) then return end

    if RootPart.Velocity.Magnitude < 50 then
        getgenv().OldPos = RootPart.CFrame
    end

    if THumanoid and THumanoid.Sit then return end

    if THead then
        workspace.CurrentCamera.CameraSubject = THead
    elseif Handle then
        workspace.CurrentCamera.CameraSubject = Handle
    elseif THumanoid then
        workspace.CurrentCamera.CameraSubject = THumanoid
    end

    local function FPos(BasePart, Pos, Ang)
        RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
        Character:SetPrimaryPartCFrame(RootPart.CFrame)
        RootPart.Velocity = Vector3.new(9e7, 9e7, 9e7)
        RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end

    local function SFBasePart(BasePart)
        local TimeToWait = 2
        local Time = tick()
        local Angle = 0
        repeat
            if RootPart and THumanoid then
                Angle += 100
                FPos(BasePart, CFrame.new(0, 1.5, 0), CFrame.Angles(math.rad(Angle), 0, 0))
                task.wait()
                FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(Angle), 0, 0))
                task.wait()
            end
        until tick() > Time + TimeToWait
    end

    workspace.FallenPartsDestroyHeight = 0/0

    local BV = Instance.new("BodyVelocity")
    BV.Parent = RootPart
    BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    BV.Velocity = Vector3.zero

    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

    if TRootPart then SFBasePart(TRootPart)
    elseif THead then SFBasePart(THead)
    elseif Handle then SFBasePart(Handle)
    end

    BV:Destroy()
    Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.CurrentCamera.CameraSubject = Humanoid

    if getgenv().OldPos then
        repeat
            RootPart.CFrame = getgenv().OldPos
            Character:SetPrimaryPartCFrame(getgenv().OldPos)
            for _, v in pairs(Character:GetChildren()) do
                if v:IsA("BasePart") then
                    v.Velocity = Vector3.zero
                    v.RotVelocity = Vector3.zero
                end
            end
            task.wait()
        until (RootPart.Position - getgenv().OldPos.Position).Magnitude < 10
        workspace.FallenPartsDestroyHeight = getgenv().FPDH
    end
end

--// ESP (EVENT-DRIVEN, OPTIMIZED)
local function setupESP(highlights, counterName, addFn, removeFn)
    local conns = {}
    local liveFolder = workspace:FindFirstChild("Live")
    if not liveFolder then return conns end

    local function watchModel(model)
        if not model:IsA("Model") or model == player.Character then return end

        -- cek langsung saat dipasang
        if model:FindFirstChild(counterName, true) then
            addFn(model)
        end

        -- hanya trigger saat Counter-nya yang muncul
        table.insert(conns, model.DescendantAdded:Connect(function(desc)
            if desc.Name == counterName then
                addFn(model)
            end
        end))

        -- hanya trigger saat Counter-nya yang hilang
        table.insert(conns, model.DescendantRemoving:Connect(function(desc)
            if desc.Name == counterName then
                task.defer(function()
                    -- pastikan model masih ada & counter benar-benar sudah tidak ada
                    if model and model.Parent and not model:FindFirstChild(counterName, true) then
                        removeFn(model)
                    end
                end)
            end
        end))
    end

    for _, model in ipairs(liveFolder:GetChildren()) do
        watchModel(model)
    end

    table.insert(conns, liveFolder.ChildAdded:Connect(function(model)
        watchModel(model)
    end))

    table.insert(conns, liveFolder.ChildRemoved:Connect(function(model)
        removeFn(model)
    end))

    -- fallback cleanup tiap 1 detik
    table.insert(conns, task.spawn(function()
        while true do
            task.wait(1)
            for model in pairs(highlights) do
                if not model or not model.Parent then
                    removeFn(model)
                end
            end
        end
    end))

    return conns
end

local function stopESP(conns, highlights, removeFn)
    for _, c in ipairs(conns) do
        if typeof(c) == "RBXScriptConnection" then
            c:Disconnect()
        elseif typeof(c) == "thread" then
            task.cancel(c)
        end
    end
    for model in pairs(highlights) do
        removeFn(model)
    end
end

local function startCounterESP()
    if counterConn then return end
    counterConn = setupESP(counterHighlights, "Counter", addHighlight, removeHighlight)
end

local function startHunterESP()
    if hunterConn then return end
    hunterConn = setupESP(hunterHighlights, "HunterCounter", addHunterHighlight, removeHunterHighlight)
end

local function stopCounterESP()
    counterESPEnabled = false
    if counterConn then
        stopESP(counterConn, counterHighlights, removeHighlight)
        counterConn = nil
    end
end

local function stopHunterESP()
    hunterESPEnabled = false
    if hunterConn then
        stopESP(hunterConn, hunterHighlights, removeHunterHighlight)
        hunterConn = nil
    end
end

