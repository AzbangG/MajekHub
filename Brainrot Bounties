--// STATE
local autoHuntTarget = false
local huntConnection = nil
local isHunting = false
local NO_COLLIDE_PARTS = {"HumanoidRootPart", "UpperTorso", "LowerTorso"}

--// BASE CFrame untuk kembali setelah target mati
local BASE_CFRAME = CFrame.new(
    -140.995132, -26.8192616, -1700.02661,
    -0.0250563994, 9.43296925e-08, -0.999686062,
    -3.11503499e-08, 1, 9.51400807e-08,
    0.999686062, 3.35244366e-08, -0.0250563994
)

--// ================= FUNGSI UTILITY =================

--// Fungsi bantu: dapatkan karakter Holder jika ada dan bukan kita
local function getHolderCharacter(targetModel)
    local holderName = targetModel:GetAttribute("Holder")
    if not holderName or holderName == "" then return nil end
    if holderName == player.Name then return nil end -- holder adalah kita sendiri, skip

    local holderPlayer = Players:FindFirstChild(holderName)
    if not holderPlayer then
        warn("[AutoHunt] Holder '" .. holderName .. "' tidak ditemukan di Players.")
        return nil
    end

    local holderChar = holderPlayer.Character
    if not holderChar then
        warn("[AutoHunt] Karakter Holder tidak ditemukan.")
        return nil
    end

    return holderChar
end

local function setNoCollide(state)
    -- state: true = no collide, false = collide normal
    if not character then return end
    for _, partName in ipairs(NO_COLLIDE_PARTS) do
        local part = character:FindFirstChild(partName)
        if part then
            part.CanCollide = not state
        end
    end
end

local function getTarget()
    return player:GetAttribute("Target")
end

local function findTargetModel(targetName)
    local brainrotsFolder = workspace:FindFirstChild("WorldCore")
        and workspace.WorldCore:FindFirstChild("Brainrots")
    if not brainrotsFolder then
        warn("[AutoHunt] Folder WorldCore.Brainrots tidak ditemukan!")
        return nil
    end

    for _, model in ipairs(brainrotsFolder:GetChildren()) do
        if model.Name == targetName then
            return model
        end
    end

    warn("[AutoHunt] Target '" .. targetName .. "' tidak ditemukan di Brainrots.")
    return nil
end

local function tweenToPosition(targetCFrame, duration)
    duration = duration or 0.5
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(humanoidRootPart, tweenInfo, { CFrame = targetCFrame })
    tween:Play()
    tween.Completed:Wait()
end

local function equipTool()
    -- Simulasi tekan tombol 1 untuk equip tool slot pertama
    VIM:SendKeyEvent(true, Enum.KeyCode.One, false, game)
    task.wait(0.1)
    VIM:SendKeyEvent(false, Enum.KeyCode.One, false, game)
    task.wait(0.3) -- tunggu tool ter-equip
end

local function clickMouse()
    -- Simulasi mouse click (hold untuk attack)
    VIM:SendMouseButtonEvent(
        player:GetMouse().X,
        player:GetMouse().Y,
        0, -- 0 = left button
        true,
        game,
        0
    )
    task.wait(0.15)
    VIM:SendMouseButtonEvent(
        player:GetMouse().X,
        player:GetMouse().Y,
        0,
        false,
        game,
        0
    )
end

local function waitForTargetDead(targetModel)
    local targetHumanoid = targetModel:FindFirstChildOfClass("Humanoid")
    if not targetHumanoid then
        warn("[AutoHunt] Humanoid tidak ditemukan di target model!")
        return
    end

    -- Tunggu sampai health = 0
    while targetHumanoid and targetHumanoid.Health > 0 do
        if not autoHuntTarget then break end -- berhenti jika toggle dimatikan
        task.wait(0.1)
    end
end

local function returnToBase()
    print("[AutoHunt] Kembali ke base...")

    setNoCollide(true)

    -- Naik sedikit ke atas dulu sebelum tween ke base
    local currentPos = humanoidRootPart.Position
    local riseUpCFrame = CFrame.new(currentPos.X, currentPos.Y + 20, currentPos.Z)
    tweenToPosition(riseUpCFrame, 0.6)

    -- Tween ke BASE_CFRAME
    tweenToPosition(BASE_CFRAME, 1.5)

    -- Kembalikan collide setelah sampai base
    setNoCollide(false)
end

--// ================= FUNGSI UTAMA HUNT =================

local function startHunt()
    if isHunting then return end
    isHunting = true

    while autoHuntTarget do
        local targetName = getTarget()
        setNoCollide(false)

        if not targetName or targetName == "" then
            print("[AutoHunt] Tidak ada target. Menunggu...")
            task.wait(1)
            continue
        end

        print("[AutoHunt] Mencari target: " .. targetName)

        local targetModel = findTargetModel(targetName)
        if not targetModel then
            task.wait(1)
            continue
        end

        --// Kunci arah kamera ke targetModel dulu
        local cameraLock = RunService.RenderStepped:Connect(function()
            local root = targetModel.PrimaryPart or targetModel:FindFirstChild("HumanoidRootPart")
            if root and root.Parent then
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, root.Position)
            end
        end)

        --// Cek apakah ada Holder
        local holderChar = getHolderCharacter(targetModel)
        local attackTarget = holderChar or targetModel
        local attackLabel = holderChar and ("Holder: " .. (targetModel:GetAttribute("Holder"))) or targetName

        --// Fungsi bantu ambil root dari attack target
        local function getAttackRoot()
            return attackTarget.PrimaryPart or attackTarget:FindFirstChild("HumanoidRootPart")
        end

        --// Update camera lock ke attack target
        cameraLock:Disconnect()
        cameraLock = RunService.RenderStepped:Connect(function()
            local root = getAttackRoot()
            if root and root.Parent then
                camera.CFrame = CFrame.lookAt(camera.CFrame.Position, root.Position)
            end
        end)

        --// Dapatkan RootPart attack target
        local attackRoot = getAttackRoot()
        if not attackRoot then
            warn("[AutoHunt] RootPart attack target tidak ditemukan!")
            cameraLock:Disconnect()
            task.wait(1)
            continue
        end

        --// Tween ke posisi tiduran di bawah attack target
        local lyingCFrame = CFrame.new(attackRoot.Position.X, attackRoot.Position.Y - 4, attackRoot.Position.Z)
            * CFrame.Angles(math.rad(90), 0, 0)

        print("[AutoHunt] Tween ke posisi " .. attackLabel .. "...")
        tweenToPosition(lyingCFrame, 0.6)

        if not autoHuntTarget then
            cameraLock:Disconnect()
            break
        end

        --// Equip tool slot 1
        print("[AutoHunt] Equip tool...")
        equipTool()

        if not autoHuntTarget then
            cameraLock:Disconnect()
            break
        end

        --// Dapatkan Humanoid attack target
        local attackHumanoid = attackTarget:FindFirstChildOfClass("Humanoid")
        if not attackHumanoid then
            warn("[AutoHunt] Humanoid attack target tidak ditemukan!")
            cameraLock:Disconnect()
            task.wait(1)
            continue
        end

        --// Attack loop
        print("[AutoHunt] Menyerang " .. attackLabel .. "...")

        while autoHuntTarget and attackHumanoid and attackHumanoid.Health > 0 do
            --// Re-cek holder tiap loop, bisa saja holder berubah
            local currentHolder = getHolderCharacter(targetModel)
            if currentHolder and currentHolder ~= attackTarget then
                print("[AutoHunt] Holder berubah! Update target serang...")
                attackTarget = currentHolder
                attackHumanoid = attackTarget:FindFirstChildOfClass("Humanoid")
                if not attackHumanoid then break end
            end

            local root = getAttackRoot()
            if root then
                local updatedCFrame = CFrame.new(root.Position.X, root.Position.Y - 4, root.Position.Z)
                    * CFrame.Angles(math.rad(90), 0, 0)
                humanoidRootPart.CFrame = updatedCFrame
            end

            clickMouse()
            task.wait(0.1)
        end

        if not autoHuntTarget then
            cameraLock:Disconnect()
            break
        end

        --// Target/Holder mati → tween ke posisi targetModel untuk loot
        print("[AutoHunt] Target mati! Menuju posisi target untuk loot...")
        task.wait(1)

        local deadRoot = targetModel.PrimaryPart or targetModel:FindFirstChild("HumanoidRootPart")
        if deadRoot then
            local lootCFrame = CFrame.new(deadRoot.Position.X, deadRoot.Position.Y + 2, deadRoot.Position.Z)
            tweenToPosition(lootCFrame, 0.5)
        end

        if not autoHuntTarget then
            cameraLock:Disconnect()
            break
        end

        --// Hold E selama 2 detik untuk ProximityPrompt
        print("[AutoHunt] Menekan E untuk ProximityPrompt...")
        VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(2)
        VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        task.wait(0.2)

        --// Lepas lock kamera
        cameraLock:Disconnect()

        --// Kembali ke base
        print("[AutoHunt] Loot selesai. Kembali ke base...")
        returnToBase()

        task.wait(1)

        if not autoHuntTarget then break end
    end

    isHunting = false
    print("[AutoHunt] Hunt dihentikan.")
end

local function stopHunt()
    autoHuntTarget = false
    isHunting = false
    print("[AutoHunt] Auto hunt dimatikan.")
end

--// ================= UI =================

local AutoTarget = Tabs.Main:AddToggle("AutoTarget", {
