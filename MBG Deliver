        game:GetService("ReplicatedStorage"):WaitForChild("SpawnMobilMBG"):FireServer("MobilMBG")
    end
})

ModeDropdown:OnChanged(function(v)
    selectedMode = v
end)

CarsDropdown:OnChanged(function(v)
    selectedCar = v
end)

AutoTrigger:OnChanged(function(v)
    autoPrompts = v

    if v then
        loopConnection = task.spawn(function()
            while autoPrompts do

                -- ===== FASE 1: Teleport & Ambil Compreng =====
                teleportToCompreng()
                enableAllPrompts()
                pressE()

                local mbgCount = getMBGCount()
                if mbgCount > 8 then
                    -- ===== FASE 2: MBG cukup → teleport ke Stock mobil =====
                    local targetCar = nil

                    if selectedMode == "Specifik" and selectedCar then
                        targetCar = getSpecificCar(selectedCar)
                    else
                        targetCar = getNearestCar()
                    end

                    if targetCar then
                        local stock = teleportToCarStock(targetCar)
                        task.wait(0.3)

                        if stock then
                            tweenLookAt(stock)
                        end
                        task.wait(0.3)

                        enableAllPrompts()
                        pressE()
                        task.wait(0.3)

                        teleportToCompreng()
                        task.wait(0.2)

                        enableAllPrompts()
                        pressE()
                        task.wait(0.3)
                    end

                else
                    -- ===== Belum cukup MBG → arahkan kamera ke Compreng =====
                    local compreng = getNearestCompreng()
                    tweenLookAt(compreng)
                end

                task.wait(0.05)
            end
        end)
    else
        if loopConnection then
            task.cancel(loopConnection)
            loopConnection = nil
        end
        if cameraTween then
            cameraTween:Cancel()
            cameraTween = nil
        end
    end
end)

