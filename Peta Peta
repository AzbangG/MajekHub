                    if part:IsA("BasePart") and part.Name == "ClientEnemy" then
                        part.ChildAdded:Connect(function(model)
                            if model:IsA("Model") then
                                addHighlightAndBillboard(model)
                            end
                        end)
                        
                        for _, existingModel in ipairs(part:GetChildren()) do
                            if existingModel:IsA("Model") then
                                addHighlightAndBillboard(existingModel)
