                if existingPart and existingPart:IsA("BasePart") then
                    existingPart.ChildAdded:Connect(function(model)
                        if model:IsA("Model") then
                            addHighlightAndBillboard(model)
                        end
                    end)
                    
                    for _, existingModel in ipairs(existingPart:GetChildren()) do
                        if existingModel:IsA("Model") then
                            addHighlightAndBillboard(existingModel)
                        end
                    end
                end
            end
        end)
    end
end)
